# Скопируйте в .env и правьте под себя: cp .env.example .env
KAFKA_VERSION=4.3.1
KAFKA_UI_VERSION=latest

# Тег Schema Registry. Сверьтесь с версией Confluent Platform, совместимой
# с вашей версией Kafka, прежде чем пинить конкретный номер.
SCHEMA_REGISTRY_VERSION=latest

# Base64 UUID кластера. Свой можно сгенерировать:
#   docker run --rm apache/kafka:4.3.1 /opt/kafka/bin/kafka-storage.sh random-uuid
CLUSTER_ID=5L6g3nShT-eMCtK--X86sw

# Bootstrap для клиентов из labs/.
# По умолчанию НЕ задавайте: ./kl сам определит адрес по тому, какое
# окружение поднято (single -> localhost:9092, cluster -> три адреса).
# Раскомментируйте, только если хотите жёстко переопределить.
# BOOTSTRAP_SERVERS=localhost:19092,localhost:29092,localhost:39092

SCHEMA_REGISTRY_URL=http://localhost:8081
